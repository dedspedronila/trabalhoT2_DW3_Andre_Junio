    "data_nascimento": "1985-04-12",
    "removido": false
}

###
# 5. Listar pacientes para selecao em consultas (GetPacientesToConsultas)
GET http://localhost:40000/getPacientesToConsultas HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

###
# 6. Exclusao logica do paciente (DeletePaciente)
DELETE http://localhost:40000/deletePaciente/1 HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

