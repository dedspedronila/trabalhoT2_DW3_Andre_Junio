###
@accessToken = {{loginAutenticado.response.body.$.token}}
@username = {{loginAutenticado.response.body.$.username}}

# 1. Inserir novo paciente (InsertPaciente)
# @name insertPaciente
POST http://localhost:40000/insertPaciente HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

{
    "nome": "Ana Clara Mendes",
    "cpf": "444.555.666-77",
