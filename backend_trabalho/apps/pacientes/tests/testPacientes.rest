}

###
# 2. Listar todos os pacientes ativos (GetAllPacientes)
GET http://localhost:40000/getAllPacientes HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

###
# 3. Buscar paciente por ID (GetPacienteByID)
GET http://localhost:40000/getPacienteByID/1 HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

###
# 4. Atualizar paciente por ID (UpdatePaciente)
PUT http://localhost:40000/updatePaciente/1 HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

{
    "nome": "Carlos Eduardo Silva Alterado",
    "cpf": "111.222.333-44",
